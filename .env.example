# TabTool local configuration
# Copy to .env and edit. .env is gitignored.

TABTOOL_HOST=127.0.0.1
TABTOOL_PORT=8000
TABTOOL_DATA_DIR=./data
# Human-readable archive for YouTube audio and imported tabs.
TABTOOL_EXTERNAL_DIR=D:\tabtool_files
TABTOOL_LAN_PIN=
# Empty PIN = every device on the LAN may control the app. Set a PIN to
# require it outside localhost; the QR pairing page logs the phone in.
# Optional: force the address the QR code uses (VPN / several adapters).
# TABTOOL_LAN_IP=192.168.1.50
TABTOOL_MAX_UPLOAD_MB=250
TABTOOL_AUDIO_RETENTION_DAYS=7

# Spotify (Phase 3). Client ID only; PKCE means no client secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
