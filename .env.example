# TabTool local configuration
# Copy to .env and edit. .env is gitignored.

TABTOOL_HOST=127.0.0.1
TABTOOL_PORT=8000
TABTOOL_DATA_DIR=./data
TABTOOL_LAN_PIN=
TABTOOL_MAX_UPLOAD_MB=250
TABTOOL_AUDIO_RETENTION_DAYS=7

# Spotify (Phase 3). Client ID only; PKCE means no client secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
